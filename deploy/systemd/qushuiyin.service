[Unit]
Description=Qushuiyin mini-program service
Wants=network-online.target
After=network-online.target mysql.service

[Service]
Type=simple
User=qushuiyin
Group=qushuiyin
EnvironmentFile=/etc/qushuiyin/production.env
WorkingDirectory=/opt/qushuiyin/current
ExecStart=/opt/qushuiyin/current/qushuiyin-server serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=35s
StateDirectory=qushuiyin
StateDirectoryMode=0700
UMask=0077
StandardOutput=journal
StandardError=journal
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
