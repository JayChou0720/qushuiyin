# Copy to /etc/qushuiyin/production.env with root ownership and mode 0600.
# The CLI does not automatically load this file. Supply real values at deployment.
APP_ENV=prod
PARSE_MODE=live
HTTP_ADDR=127.0.0.1:8080
TRUSTED_PROXY_CIDRS=127.0.0.1/32
PUBLIC_API_BASE_URL=https://api.example.invalid
PUBLIC_MEDIA_BASE_URL=https://media.example.invalid
ADMIN_PUBLIC_HOST=ops.example.invalid
ADMIN_ALLOWED_ORIGINS=https://ops.example.invalid
MYSQL_DSN=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
DATA_ENCRYPTION_KEYS=
HMAC_KEY=
TICKET_SIGNING_KEY=
MEDIA_DIR=/var/lib/qushuiyin/media
FFPROBE_PATH=/usr/bin/ffprobe
# Leave WECHAT_DEV_LOGIN, MOCK_MEDIA_ORIGIN and platform cookie/proxy overrides unset.
