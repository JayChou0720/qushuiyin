# PowerShell: set $env:NAME explicitly; the CLI does not load .env files.
APP_ENV=local
PARSE_MODE=mock
# Same-host Nginx uses 127.0.0.1/32 when configured. Leave empty for direct requests.
TRUSTED_PROXY_CIDRS=
# Set only for migrate or persistent live observation, in a local environment.
MYSQL_DSN=
DATA_ENCRYPTION_KEYS=
MEDIA_DIR=
FFPROBE_PATH=
# No platform account cookies. WeChat credentials are not needed by probe.
