.asset-option { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 56px; border-top: 1px solid #e0e6ef; }
.asset-check { display: flex; align-items: center; gap: 6px; min-height: 44px; flex: 1; overflow-wrap: anywhere; }
button.thumb-button { min-width: 104px; justify-content: flex-end; }
.thumbnail { width: 40px; height: 40px; flex: 0 0 40px; border-radius: 4px; }
.video-frame { display: flex; align-items: center; justify-content: center; position: relative; aspect-ratio: 16 / 9; min-height: 135px; background: #edf1f5; border-radius: 8px; overflow: hidden; }
.video-poster, .preview-video { position: absolute; inset: 0; width: 100%; height: 100%; }
button.play { position: relative; }
.frame-message { padding: 12px; color: #526179; }
.preview-panel { gap: 8px; }
.preview-image { display: block; width: 100%; border-radius: 8px; }
.caption { color: #35455e; white-space: pre-wrap; overflow-wrap: anywhere; }
.save-actions { flex-wrap: wrap; }
