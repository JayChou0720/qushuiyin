.history-heading, .history-caption { flex-wrap: wrap; }
.history-caption { border-bottom: 1px solid #e0e6ef; }
.history-empty { display: flex; flex-direction: column; gap: 12px; }
.history-item { display: flex; align-items: center; gap: 4px; padding: 8px; border: 1px solid #e0e6ef; border-radius: 8px; background: #fff; }
button.history-open { margin: 0; padding: 4px; flex: 1 1 0; width: 0; min-width: 0; min-height: 48px; display: flex; gap: 12px; align-items: center; text-align: left; background: transparent; color: #18243b; line-height: 1.4; box-sizing: border-box; }
.history-open::after { border: 0; }
.history-thumb { display: flex; align-items: center; justify-content: center; width: 56px; height: 52px; flex: 0 0 56px; border-radius: 6px; }
.history-placeholder { background: #edf3ff; color: #244fbd; font-size: 13px; }
.history-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; overflow-wrap: anywhere; }
.history-title { font-size: 15px; font-weight: 650; }
button.history-remove, button.history-clear { min-height: 48px; min-width: 48px; color: #9d2330; }
button.history-remove { flex: 0 0 52px; width: 52px; box-sizing: border-box; }
button.history-clear { width: auto; }
