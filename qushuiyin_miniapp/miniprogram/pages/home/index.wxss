.share-input { box-sizing: border-box; width: 100%; min-height: 122px; max-height: 160px; padding: 12px; border: 1px solid #cdd6e6; border-radius: 8px; background: #fafbfd; overflow-wrap: anywhere; }
.grow { flex: 1; }
.platform-section { gap: 10px; }
.notice { white-space: pre-wrap; overflow-wrap: anywhere; }
.platforms { display: flex; flex-wrap: wrap; gap: 8px 16px; }
.platform { color: #526179; font-size: 14px; }
.platform.available { color: #236655; }
