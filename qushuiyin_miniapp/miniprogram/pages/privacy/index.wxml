<view class="screen stack privacy-screen">
  <text class="title">数据与隐私</text>

  <view class="privacy-section">
    <text class="section-title">数据如何使用</text>
    <text class="muted">解析所需信息会发送至服务器处理。最近记录仅保存在本机。</text>
    <text class="muted">仅在你点击粘贴时读取剪贴板。相册权限用于保存你主动选择的作品。</text>
    <button class="action privacy-action" bindtap="showContract" hover-class="button-press">微信隐私保护指引</button>
    <text wx:if="{{legalMessage}}" class="muted" role="status">{{legalMessage}}</text>
    <text class="muted">正式用户协议尚未发布。</text>
  </view>

  <view class="privacy-section">
    <text class="section-title">本机数据</text>
    <view class="history-setting" wx:if="{{historyReady}}">
      <text>记录解析历史</text>
      <switch checked="{{historyEnabled}}" disabled="{{busy !== ''}}" bindchange="toggleHistory" color="#176a5b" aria-label="记录解析历史" />
    </view>
    <button wx:else class="action privacy-action" bindtap="configureHistory" disabled="{{busy !== ''}}" loading="{{busy === 'history'}}" hover-class="button-press">设置最近记录</button>
    <text wx:if="{{historyMessage}}" class="muted" role="status">{{historyMessage}}</text>
    <text class="muted">清理缓存会删除临时下载文件和缩略图，保留记录文字及相册文件。</text>
    <button class="action privacy-action" bindtap="clearLocal" disabled="{{busy !== ''}}" loading="{{busy === 'local'}}" hover-class="button-press">清理本机缓存</button>
    <text wx:if="{{localMessage}}" class="muted" role="status">{{localMessage}}</text>
  </view>

  <view class="privacy-section">
    <text class="section-title">服务端数据</text>
    <text class="muted">清除解析结果、相关链接、反馈和联系方式，并撤销旧会话和本服务签发的媒体访问凭证。已下载到相册的文件会保留。</text>
    <button class="action danger privacy-action" bindtap="confirmRemote" disabled="{{busy !== ''}}" loading="{{busy === 'remote'}}" hover-class="button-press">{{busy === 'remote' ? '正在提交清除请求' : '清除服务端数据'}}</button>
    <text wx:if="{{remoteError}}" class="error" role="alert">{{remoteError}}</text>
  </view>

  <navigator class="action-link quiet-link" url="/pages/feedback/create" hover-class="button-press">问题反馈</navigator>
</view>
