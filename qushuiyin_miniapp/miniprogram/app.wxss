page { background: #f5f7fa; color: #18243b; font-family: system-ui, sans-serif; font-size: 16px; line-height: 1.5; }
.screen { padding: 24px 20px 32px; padding-bottom: calc(32px + env(safe-area-inset-bottom)); max-width: 540px; margin: 0 auto; }
.title { font-size: 26px; font-weight: 700; line-height: 1.24; }
.section-title { font-size: 16px; font-weight: 650; }
.muted { color: #526179; font-size: 14px; }
.surface { background: #fff; border: 1px solid #e0e6ef; border-radius: 8px; padding: 16px; }
.row { display: flex; align-items: center; gap: 8px; }
.spread { justify-content: space-between; }
.stack { display: flex; flex-direction: column; gap: 16px; }
button.action { margin: 0; min-height: 44px; border-radius: 8px; padding: 8px 14px; display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 15px; line-height: 1.4; background: #edf3ff; color: #244fbd; }
button.action::after { border: 0; }
button.primary { background: #2458dc; color: white; font-weight: 650; }
button.quiet { background: transparent; padding: 4px 8px; }
button.action[disabled] { background: #e9edf4; color: #526179; }
.button-press { opacity: 0.78; }
.error { color: #9d2330; background: #fff1f1; border-radius: 8px; padding: 10px 12px; font-size: 14px; }
.badge { color: #2653bd; background: #edf3ff; border-radius: 4px; padding: 3px 8px; font-size: 12px; }
.icon { width: 18px; height: 18px; flex: 0 0 18px; }
.action-link { min-height: 48px; display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding: 8px 14px; border-radius: 8px; background: #edf3ff; color: #244fbd; font-size: 15px; line-height: 1.4; }
.primary-link { background: #2458dc; color: #fff; font-weight: 650; }
.quiet-link { background: transparent; align-self: flex-start; }
.help-feedback { gap: 8px; }
